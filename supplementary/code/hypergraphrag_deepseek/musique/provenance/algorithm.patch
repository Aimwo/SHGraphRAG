+class LLMUnavailableError(RuntimeError):
+    """A terminal unusable output, retained without using its partial text."""
+
+    outcome = "unavailable_output"
+
+    def __init__(self, reason, request_sha256, raw_text="", response_id=None):
+        super().__init__(reason)
+        self.request_sha256 = request_sha256
+        self.raw_text = raw_text
+        self.response_id = response_id
+
+
+class LLMRefusalError(LLMUnavailableError):
+    """An explicit provider content filter/refusal."""
+
+    outcome = "provider_filtered"
+
+
+class LLMTruncationError(LLMUnavailableError):
+    """An output that reached its recorded token cap."""
+
+    outcome = "output_truncated"
+
+
+class LLMIncompleteError(LLMUnavailableError):
+    """An output with no reported completion boundary; cause is unknown."""
+
+    outcome = "output_incomplete"
+
